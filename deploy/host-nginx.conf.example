# Host Nginx reverse proxy for the Laser Tag Docker container.
# Production host Nginx reverse proxy for Combat Zone.
# Copy this into /etc/nginx/sites-available/combatzone.
#
# The Docker container is only bound to 127.0.0.1:5173, so the public entry point
# remains the host Nginx instance on port 80.

server {
    listen 80;
    listen [::]:80;

    server_name combatzone.v79sl.com;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
