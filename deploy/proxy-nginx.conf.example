# Optional Nginx container on the existing proxy_network.
# For Nginx Proxy Manager, configure its Proxy Host UI instead.
# This example handles HTTP; configure TLS at your public reverse proxy.

server {
    listen 80;
    listen [::]:80;

    server_name combatzone.v79sl.com;

    client_max_body_size 85m;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;

    location / {
        proxy_pass http://lasertag:5173;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
