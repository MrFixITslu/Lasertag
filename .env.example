# Copy to .env, set a unique password of at least 16 characters, and chmod 600 .env.
# Never use VITE_ for credentials: those variables are public in browser builds.
PUBLIC_ORIGIN=https://combatzone.v79sl.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional marketing email. SMTP must support TLS; use 465 or 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_BUSINESS_ADDRESS=
# Optional official social publishing credentials. Never prefix these with VITE_.
META_GRAPH_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
